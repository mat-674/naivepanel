# Normalize line endings. Without this, a Windows checkout stores CRLF, which
# trips gofmt on every Go file and — critically — makes scripts/install.sh
# unrunnable on Linux (a `#!/bin/bash\r` shebang is not a valid interpreter).
* text=auto eol=lf

# Explicitly keep LF on files that must have it regardless of platform.
*.go    text eol=lf
*.sh    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Windows batch files need CRLF.
*.bat   text eol=crlf

# Binary assets — never touch.
*.png   binary
